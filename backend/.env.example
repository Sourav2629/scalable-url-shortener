# LinkSphere backend environment configuration template.
#
# SECURITY NOTES:
# - Never commit real credentials or secrets to version control.
# - Generate JWT secrets with a cryptographically random generator, e.g.:
#     node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

PORT=5000
NODE_ENV=development

# ── Database (REQUIRED) ──────────────────────────────────────
# MongoDB connection string. The application fails to start without it.
MONGODB_URI=

# ── Redis / BullMQ (analytics queue) ─────────────────────────
REDIS_URL=

# ── JWT secrets (REQUIRED) ───────────────────────────────────
# JWT_ACCESS_SECRET and JWT_REFRESH_SECRET are both required and MUST differ.
# PRODUCTION REQUIREMENT: each secret must be at least 32 characters long.
# Weak/known values and identical secrets are rejected at startup in production.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

JWT_ACCESS_TOKEN_EXPIRES_IN=15m

JWT_REFRESH_TOKEN_EXPIRES_IN=7d

SHUTDOWN_TIMEOUT=10000

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins, or '*' for development only.
# Wildcard CORS is rejected at request time in production.
CORS_ALLOWED_ORIGINS=*

# ── Express trust proxy ──────────────────────────────────────
# false = direct connection / development (default)
# true = trust all proxies (not recommended for production)
# 1 = trust one reverse proxy/load balancer hop
# 2 = trust two proxy hops
# Only enable when deployed behind a trusted reverse proxy.
TRUST_PROXY=false

# Rate Limiting
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW_MS=900000
RATE_LIMIT_OTP_MAX=10
RATE_LIMIT_OTP_WINDOW_MS=900000
RATE_LIMIT_PASSWORD_RESET_MAX=5
RATE_LIMIT_PASSWORD_RESET_WINDOW_MS=900000
RATE_LIMIT_RESEND_MAX=5
RATE_LIMIT_RESEND_WINDOW_MS=900000
RATE_LIMIT_SESSION_MAX=60
RATE_LIMIT_SESSION_WINDOW_MS=900000
RATE_LIMIT_CHANGE_PASSWORD_MAX=10
RATE_LIMIT_CHANGE_PASSWORD_WINDOW_MS=900000
RATE_LIMIT_DELETE_ACCOUNT_MAX=5
RATE_LIMIT_DELETE_ACCOUNT_WINDOW_MS=900000
RATE_LIMIT_REFRESH_MAX=20
RATE_LIMIT_REFRESH_WINDOW_MS=900000
RATE_LIMIT_PUBLIC_MAX=100
RATE_LIMIT_PUBLIC_WINDOW_MS=60000
RATE_LIMIT_PUBLIC_SHORTEN_MAX=10
RATE_LIMIT_PUBLIC_SHORTEN_WINDOW_MS=60000
RATE_LIMIT_API_MAX=300
RATE_LIMIT_API_WINDOW_MS=900000

# Email Configuration
EMAIL_PROVIDER=brevo
EMAIL_FROM_EMAIL=noreply@linksphere.app
EMAIL_FROM_NAME=LinkSphere
BREVO_API_KEY=
BREVO_API_URL=https://api.brevo.com/v3
